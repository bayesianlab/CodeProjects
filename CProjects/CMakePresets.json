{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 (Visual Studio)",
      "description": "Configure the project using the Visual Studio generator (x64) and vcpkg.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "C:/Users/USER/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_GENERATOR_PLATFORM": "x64"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja",
      "description": "Configure the project using the Ninja generator and vcpkg.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
          "toolset": {
        "value": "version=14.51",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "C:/Users/USER/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "release",
      "displayName": "MSVC x64 Release",
      "description": "Configure the project using the Visual Studio generator (x64) and vcpkg for a Release build.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "C:/Users/USER/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_GENERATOR_PLATFORM": "x64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Build the release preset.",
      "configuration": "Release"
    }
  ]
}
